TIDB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=YOUR_TIDB_USER
TIDB_PASSWORD=YOUR_NEW_PASSWORD
TIDB_DATABASE=ai_receptionist
TIDB_SSL_MODE=verify-full
TIDB_CA_PATH=./certs/ca.pem

DATABASE_URL=

# Intent classification LLM: mock (rule-based only), openai, or anthropic.
# With openai/anthropic the LLM classifies intent; the deterministic rule
# engine still extracts entities and is used as a fallback on any failure.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Delivery. When DRY_RUN=true notifications are logged and marked SENT without
# contacting any provider. Set DRY_RUN=false and configure a provider to send
# for real; an enabled-but-unconfigured channel is recorded as FAILED.
DRY_RUN=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@100solutionz.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Tenant API keys for /api/v1 (comma-separated tenant_id:secret pairs)
API_KEYS=clinic_001:replace-with-long-random-key