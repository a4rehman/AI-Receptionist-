TIDB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=YOUR_TIDB_USER
TIDB_PASSWORD=YOUR_NEW_PASSWORD
TIDB_DATABASE=ai_receptionist
TIDB_SSL_MODE=verify-full
TIDB_CA_PATH=./certs/ca.pem

DATABASE_URL=

# Intent classification LLM: mock (rule-based only), openai, or anthropic.
# With openai/anthropic the LLM classifies intent; the deterministic rule
# engine still extracts entities and is used as a fallback on any failure.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Tenant API keys for /api/v1 (comma-separated tenant_id:secret pairs)
API_KEYS=clinic_001:replace-with-long-random-key